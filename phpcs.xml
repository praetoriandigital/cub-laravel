<?xml version="1.0"?>
<ruleset name="cub-laravel">
    <rule ref="PSR12"/>
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.2-8.3"/>
    <file>src</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="warning-severity" value="0"/>
    <arg value="p"/>
</ruleset>
