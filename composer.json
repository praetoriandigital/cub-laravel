{
  "name": "cub/cub-laravel",
  "description": "Laravel wrapper for cub/cub",
  "keywords": ["cub", "laravel"],
  "license": "MIT",
  "homepage": "https://github.com/praetoriandigital/cub-laravel",
  "require": {
    "php": "^8.0.2 || ^8.1 || ^8.2 || ^8.3",
    "cub/cub": "~0.1",
    "firebase/php-jwt": "^6.0",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/container": "^8.0|^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "squizlabs/php_codesniffer": "^3.9",
    "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/php-compatibility": "dev-develop"
  },
  "autoload": {
    "classmap": [
      "src/migrations"
    ],
    "psr-4": { "Cub\\CubLaravel\\": "src/Cub/CubLaravel/" }
  },
  "autoload-dev": {
    "psr-4": { "Cub\\CubLaravel\\Test\\": "tests/Cub/CubLaravel/Test/" }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "vendor/bin/phpunit",
    "check-style": "phpcs -p --standard=PSR12 src tests",
    "fix-style": "phpcbf -p --standard=PSR12 src tests",
    "compat": "phpcs -p --standard=PHPCompatibility --runtime-set testVersion 8.2-8.3 --warning-severity=0 src"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
